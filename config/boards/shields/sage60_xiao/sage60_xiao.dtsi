#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/diwamoto/sage60-layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &diwamoto_sage60_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        // | SW1  | SW2  |    |  SW3  | SW4  |
        // | SW5  | SW6  |    |  SW7  | SW8  |
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* D0 */
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* D1 */
            ;
    };
};

&diwamoto_sage60_layout {
    transform = <&default_transform>;
};
