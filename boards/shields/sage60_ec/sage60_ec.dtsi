#include <zephyr/dt-bindings/dt-util.h>
#include <zephyr/dt-bindings/adc/adc.h>

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &matrix;
    };

    diwamoto_sage60_ec_layout: diwamoto_sage60_ec_layout {
        compatible = "zmk,physical-layout";
        display-name = "LAYOUT";

        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   55       0     0     0> // 0  row0,col0
            , <&key_physical_attrs 100 100  100   55       0     0     0> // 1  row0,col1
            , <&key_physical_attrs 100 100  200   10       0     0     0> // 2  row0,col2
            , <&key_physical_attrs 100 100  300    0       0     0     0> // 3  row0,col3
            , <&key_physical_attrs 100 100  400   10       0     0     0> // 4  row0,col4
            , <&key_physical_attrs 100 100  500   20       0     0     0> // 5  row0,col5
            , <&key_physical_attrs 100 100 1400   55       0     0     0> // 6  row0,col11
            , <&key_physical_attrs 100 100 1300   55       0     0     0> // 7  row0,col10
            , <&key_physical_attrs 100 100 1200   10       0     0     0> // 8  row0,col9
            , <&key_physical_attrs 100 100 1100    0       0     0     0> // 9  row0,col8
            , <&key_physical_attrs 100 100 1000   10       0     0     0> // 10 row0,col7
            , <&key_physical_attrs 100 100  900   20       0     0     0> // 11 row0,col6
            , <&key_physical_attrs 100 100    0  155       0     0     0> // 12 row1,col0
            , <&key_physical_attrs 100 100  100  155       0     0     0> // 13 row1,col1
            , <&key_physical_attrs 100 100  200  110       0     0     0> // 14 row1,col2
            , <&key_physical_attrs 100 100  300  100       0     0     0> // 15 row1,col3
            , <&key_physical_attrs 100 100  400  110       0     0     0> // 16 row1,col4
            , <&key_physical_attrs 100 100  500  120       0     0     0> // 17 row1,col5
            , <&key_physical_attrs 100 100  600   75       0     0     0> // 18 row1,col6
            , <&key_physical_attrs 100 100 1400  155       0     0     0> // 19 row1,col11
            , <&key_physical_attrs 100 100 1300  155       0     0     0> // 20 row1,col10
            , <&key_physical_attrs 100 100 1200  110       0     0     0> // 21 row1,col9
            , <&key_physical_attrs 100 100 1100  100       0     0     0> // 22 row1,col8
            , <&key_physical_attrs 100 100 1000  110       0     0     0> // 23 row1,col7
            , <&key_physical_attrs 100 100  900  120       0     0     0> // 24 row1,col6
            , <&key_physical_attrs 100 100  800   75       0     0     0> // 25 row1,col7
            , <&key_physical_attrs 100 100    0  255       0     0     0> // 26 row2,col0
            , <&key_physical_attrs 100 100  100  255       0     0     0> // 27 row2,col1
            , <&key_physical_attrs 100 100  200  210       0     0     0> // 28 row2,col2
            , <&key_physical_attrs 100 100  300  200       0     0     0> // 29 row2,col3
            , <&key_physical_attrs 100 100  400  210       0     0     0> // 30 row2,col4
            , <&key_physical_attrs 100 100  500  220       0     0     0> // 31 row2,col5
            , <&key_physical_attrs 100 100  600  175       0     0     0> // 32 row2,col6
            , <&key_physical_attrs 100 100 1400  255       0     0     0> // 33 row2,col11
            , <&key_physical_attrs 100 100 1300  255       0     0     0> // 34 row2,col10
            , <&key_physical_attrs 100 100 1200  210       0     0     0> // 35 row2,col9
            , <&key_physical_attrs 100 100 1100  200       0     0     0> // 36 row2,col8
            , <&key_physical_attrs 100 100 1000  210       0     0     0> // 37 row2,col7
            , <&key_physical_attrs 100 100  900  220       0     0     0> // 38 row2,col6
            , <&key_physical_attrs 100 100  800  175       0     0     0> // 39 row2,col7
            , <&key_physical_attrs 100 100    0  355       0     0     0> // 40 row3,col0
            , <&key_physical_attrs 100 100  100  355       0     0     0> // 41 row3,col1
            , <&key_physical_attrs 100 100  200  310       0     0     0> // 42 row3,col2
            , <&key_physical_attrs 100 100  300  300       0     0     0> // 43 row3,col3
            , <&key_physical_attrs 100 100  400  310       0     0     0> // 44 row3,col4
            , <&key_physical_attrs 100 100  500  320       0     0     0> // 45 row3,col5
            , <&key_physical_attrs 100 100  600  275       0     0     0> // 46 row3,col6
            , <&key_physical_attrs 100 100 1400  355       0     0     0> // 47 row3,col11
            , <&key_physical_attrs 100 100 1300  355       0     0     0> // 48 row3,col10
            , <&key_physical_attrs 100 100 1200  310       0     0     0> // 49 row3,col9
            , <&key_physical_attrs 100 100 1100  300       0     0     0> // 50 row3,col8
            , <&key_physical_attrs 100 100 1000  310       0     0     0> // 51 row3,col7
            , <&key_physical_attrs 100 100  900  320       0     0     0> // 52 row3,col6
            , <&key_physical_attrs 100 100  800  275       0     0     0> // 53 row3,col7
            , <&key_physical_attrs 125 100  200  410       0     0     0> // 54 row4,col2
            , <&key_physical_attrs 125 100  385  365     750     0     0> // 55 row4,col3
            , <&key_physical_attrs 100 100  560  295    1500     0     0> // 56 row4,col4
            , <&key_physical_attrs 100 150  705  155    2250     0     0> // 57 row4,col5
            , <&key_physical_attrs 125 100 1175  410       0     0     0> // 58 row4,col9
            , <&key_physical_attrs 125 100  980  560  (-750)     0     0> // 59 row4,col8
            , <&key_physical_attrs 100 100  790  685 (-1500)     0     0> // 60 row4,col7
            , <&key_physical_attrs 100 150  585  735 (-2250)     0     0> // 61 row4,col8
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |                 | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |                 | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |                 | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
// | SW19 | SW20 | SW21 | SW22 | SW23 | SW24 |                 | SW24 | SW23 | SW22 | SW21 | SW20 | SW19 |
//                      | SW25 | SW26 | SW27 | SW28 |   | SW28 | SW27 | SW26 | SW25 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,12) RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,13) RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,13) RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)  RC(3,13) RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7)
                RC(4,2) RC(4,3) RC(4,4) RC(4,5)                   RC(4,12) RC(4,11) RC(4,10) RC(4,9)
        >;
    };

    mux: mux {
		compatible = "zmk,gpio-mux";
		select-gpios
			= <&xiao_d 4 GPIO_ACTIVE_HIGH>,       /* D4 */
            <&xiao_d 5 GPIO_ACTIVE_HIGH>,   /* D5 */
            <&xiao_d 6 GPIO_ACTIVE_HIGH>;   /* D6 */

		en-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>;

		gpio-controller;
		ngpios = <8>;
		#gpio-cells = <2>;
	};

    matrix: matrix {
		compatible = "zmk,kscan-ec-matrix";

		matrix-relax-us = <1000>;
		adc-read-settle-us = <1>;

		strobe-gpios
			= <&xiao_d 1 GPIO_ACTIVE_HIGH>,       /* D1 */
            <&xiao_d 2 GPIO_ACTIVE_HIGH>,       /* D2 */
            <&gpio0 16 GPIO_ACTIVE_HIGH>,        /* P0.16 */
            <&gpio1 0 GPIO_ACTIVE_HIGH>,        /* P1.0 */ 
            <&gpio1 10 GPIO_ACTIVE_HIGH>;        /* P1.10 */

		input-gpios
			= <&mux 4 0>
			, <&mux 6 0>
			, <&mux 7 0>
			, <&mux 5 0>
			, <&mux 1 0>
			, <&mux 0 0>
			;

		drain-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;
		io-channels = <&adc 1>;
        power-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
	    matrix-warm-up-us = <500>;
		strobe-input-masks = <
			0
			0
			0
			(BIT(0) + BIT(1) + BIT(2) + BIT(9) + BIT(10) + BIT(11))
			>;
	};
};

&adc {
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@1 {
        reg = <1>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 */
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
        zephyr,resolution = <8>;
    };
};