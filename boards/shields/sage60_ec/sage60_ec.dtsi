#include <zephyr/dt-bindings/dt-util.h>
#include <zephyr/dt-bindings/adc/adc.h>

#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/diwamoto/sage60-ec-layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &diwamoto_sage60_ec_layout;
        zmk,kscan = &matrix;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |                 | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |                 | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |                 | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
// | SW19 | SW20 | SW21 | SW22 | SW23 | SW24 |                 | SW24 | SW23 | SW22 | SW21 | SW20 | SW19 |
//                      | SW25 | SW26 | SW27 | SW28 |   | SW28 | SW27 | SW26 | SW25 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,12) RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,13) RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,13) RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)  RC(3,13) RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7)
                RC(4,2) RC(4,3) RC(4,4) RC(4,5)                   RC(4,12) RC(4,11) RC(4,10) RC(4,9)
        >;
    };

    mux: mux {
		compatible = "zmk,gpio-mux";
		select-gpios
			= <&xiao_d 4 GPIO_ACTIVE_HIGH>,       /* D4 */
            <&xiao_d 5 GPIO_ACTIVE_HIGH>,   /* D5 */
            <&xiao_d 6 GPIO_ACTIVE_HIGH>;   /* D6 */

		en-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>;

		gpio-controller;
		ngpios = <8>;
		#gpio-cells = <2>;
	};

    matrix: matrix {
		compatible = "zmk,kscan-ec-matrix";

		matrix-relax-us = <1000>;
		adc-read-settle-us = <1>;

		strobe-gpios
			= <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,       /* D1 */
            <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,       /* D2 */
            <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,        /* P0.16 */
            <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,        /* P1.0 */
            <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;        /* P1.10 */

		input-gpios
			= <&mux 4 0>
			, <&mux 6 0>
			, <&mux 7 0>
			, <&mux 5 0>
			, <&mux 1 0>
			, <&mux 0 0>
			;

		drain-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;
		io-channels = <&adc 1>;
        power-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
	    matrix-warm-up-us = <500>;
		strobe-input-masks = <
			0
			0
			0
			(BIT(0) + BIT(1) + BIT(2) + BIT(9) + BIT(10) + BIT(11))
			>;
	};
};

&adc {
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@1 {
        reg = <1>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 */
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
        zephyr,resolution = <8>;
    };
};

&diwamoto_sage60_ec_layout {
    transform = <&default_transform>;
};
